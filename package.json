  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "^13.6.0",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
