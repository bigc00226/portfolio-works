{
  "name": "process-portfolio",
  "private": true,
  "description": "Trust Portfolio — 制作過程の動画ポートフォリオ（Next.js）。動画のページは public/videos/<id>/、一覧と再生ページは app/。",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
