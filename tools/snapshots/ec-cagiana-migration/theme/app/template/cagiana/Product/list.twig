<script>
// 元selectタグからデザイン用の新しい選択肢を構成
$('#order_by_select_src select').each(function() {
	// URIのパラメータを分解して orderby の値を取得
									
	// 選択委の構造を再生成
	var classes = $(this).attr("class"),
		id      = $(this).attr("id");
	var template =  '<div class="' + classes + '">';
		template += '<div class="custom-select-trigger"><span id="select_value">並び替え</span><i class="fas fa-angle-up"></i></div>';
		template += '<div class="custom-options">';
	$(this).find("option").each(function() {
		template += '<div class="custom-option ' + $(this).attr("class") + '" data-value="' + $(this).attr("value") + '">' + $(this).html() + '</div>';
	});
	template += '</div></div>';

	$(this).wrap('<div class="custom-select-wrapper"></div>');
	$(this).hide();
	$(this).after(template);

	$('div.custom-select').removeClass('form-control');

});

$(".custom-option:first-of-type").hover(function() {
	$(this).parents(".custom-options").addClass("option-hover");
}, function() {
	$(this).parents(".custom-options").removeClass("option-hover");
});

$(".custom-select-trigger").on("click", function() {
	$('html').one('click', function() {
		$('.custom-select-trigger i').removeClass('fa-angle-down');
		$('.custom-select-trigger i').addClass('fa-angle-up');
		$(".custom-select").removeClass("opened");
	});
	$(this).parents(".custom-select").toggleClass("opened");
		if ($(this).parents(".custom-select").hasClass("opened")) {
			$('.custom-select-trigger i').removeClass('fa-angle-up');
			$('.custom-select-trigger i').addClass('fa-angle-down');
		} else {
			$('.custom-select-trigger i').removeClass('fa-angle-down');
			$('.custom-select-trigger i').addClass('fa-angle-up');
		}
		event.stopPropagation();
});

$(".custom-option").on("click", function() {
	$(this).parents(".custom-select-wrapper").find("select").val($(this).data("value"));
	$(this).parents(".custom-options").find(".custom-option").removeClass("selection");
	$(this).addClass("selection");
	$(this).parents(".custom-select").removeClass("opened");
	$(this).parents(".custom-select").find(".custom-select-trigger #select_value").text($(this).text());
	
	fnChangeOrderBy($(this).attr('data-value'));
});

$(window).on('load', function() {
	// URIパラメータの分割
	uris = location.search.replace('?', '').split('&');
	param = Array();
	for (i = 0; i < uris.length; i++) {
		data = uris[i].split('=');
		param[data[0]] = data[1];
	}
	// 車両情報入力の督促メールからの表示の場合の対処
	if ('orderby' in param) {
		target = $('#result_info_box__menu_box').offset().top - $('#header').innerHeight();
		$('html,body').animate({scrollTop : target}, 0);
	}

});
</script>
