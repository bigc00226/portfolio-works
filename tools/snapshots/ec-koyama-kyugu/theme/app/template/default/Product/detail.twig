{#
商品詳細（公開中の商品ページと同じマークアップ）
#}
{% extends 'default_frame.twig' %}

{% set body_class = 'product_page' %}

{% block javascript %}
    <script>
        eccube.classCategories = {{ class_categories_as_json(Product)|raw }};
        function fnSetClassCategories(form, classcat_id2_selected) {
            var $form = $(form);
            var product_id = $form.find('input[name=product_id]').val();
            var $sele1 = $form.find('select[name=classcategory_id1]');
            var $sele2 = $form.find('select[name=classcategory_id2]');
            eccube.setClassCategories($form, product_id, $sele1, $sele2, classcat_id2_selected);
        }
        {% if form.classcategory_id2 is defined %}
        fnSetClassCategories($('#form1'), {{ form.classcategory_id2.vars.value|json_encode|raw }});
        {% elseif form.classcategory_id1 is defined %}
        eccube.checkStock($('#form1'), {{ Product.id }}, {{ form.classcategory_id1.vars.value|json_encode|raw }}, null);
        {% endif %}
        $(function() {
            $('.SliderFor').slick({ arrows: false, fade: true, asNavFor: '.SliderNav' });
            $('.SliderNav').slick({ slidesToShow: 4, asNavFor: '.SliderFor', focusOnSelect: true, arrows: false });
        });
    </script>
{% endblock %}

{% block main %}
    {% set Category = (Product.ProductCategories|first).Category ?? null %}
    <div id="breadcrumb">
        <ul>
            <li><a href="{{ url('homepage') }}">トップページ</a></li>
            {% if Category %}{% for C in Category.path %}
            <li><a href="{{ url('product_list') }}?category_id={{ C.id }}">{{ C.name }}</a></li>
            {% endfor %}{% endif %}
            <li>{{ Product.name }}</li>
        </ul>
    </div><!-- /.breadcrumb -->
    <div class="productPower">
        <div class="recomArea">
            <div class="detailWrap">
                <div class="detailBox clearfix">
                    <div class="detailLeft">
                        <div class="detailItem">
                            <div class="SliderFor">
                                {% for ProductImage in Product.ProductImage %}
                                <p class="SliderItem">
                                    <span class="SliderItem_img">
                                        <a rel="image" href="{{ asset(ProductImage, 'save_image') }}" class="SliderBtn fancybox">
                                            <img src="/html/template/default/assets/project/img/detail/serch.png" alt="">
                                        </a>
                                        <img src="{{ asset(ProductImage, 'save_image') }}">
                                    </span>
                                </p>
                                {% endfor %}
                            </div>
                            <div class="SliderNav">
                                {% for ProductImage in Product.ProductImage %}
                                <div class="silderItem">
                                    <img src="{{ asset(ProductImage, 'save_image') }}">
                                </div>
                                {% endfor %}
                            </div>
                        </div><!-- /.detailItem -->
                    </div>
                    <div class="detailRight">
                        <div class="detailMari">
                            <p class="detail01 NotoSerifJp">{{ Product.name }}</p>
                            <p class="detail02">
                                <span class="col01">通販価格</span>
                                <span class="col02">
                                    <span class="price02-default">
                                        {{ Product.getPrice02IncTaxMin|number_format }}{% if Product.getPrice02IncTaxMin != Product.getPrice02IncTaxMax %}～{% endif %}
                                    </span>
                                    <em>円</em>
                                </span>（税込）
                            </p>
                            <div class="detail03">
                                <p class="col01">
                                    {% for Tag in Product.Tags %}
                                    <span class="active">{{ Tag }}</span>
                                    {% endfor %}
                                </p>
                                {% if Product.Tags|filter(t => t.name starts with '送料')|length > 0 %}
                                <p class="col02"><a href="#anchor03">料金表を見る</a></p>
                                {% endif %}
                            </div>
                            <p class="detail04">{{ Product.free_area|raw }}</p>
                            <form action="{{ url('product_add_cart', {id:Product.id}) }}" method="post" id="form1" name="form1">
                                {% if Product.stock_find %}
                                {% if form.classcategory_id1 is defined %}
                                <div class="detailOline">
                                    <dl>
                                        <dt>{{ form_label(form.classcategory_id1, Product.ClassName1) }}</dt>
                                        <dd>
                                            <h3><span>{{ form_widget(form.classcategory_id1, { attr: { class: 'form-control' } }) }}</span></h3>
                                            {% if form.classcategory_id2 is defined %}
                                            <h3><span>{{ form_widget(form.classcategory_id2, { attr: { class: 'form-control' } }) }}</span></h3>
                                            {% endif %}
                                            {% if Product.description_list %}<p>{{ Product.description_list|nl2br }}</p>{% endif %}
                                        </dd>
                                    </dl>
                                </div>
                                {% endif %}
                                <div class="detailFind">
                                    <dl>
                                        <dt>数量</dt>
                                        <dd>
                                            <div class="detailMart">
                                                <h3>
                                                    <span>
                                                        <select id="quantity" name="quantity" class="form-control">
                                                            {% for q in 1..10 %}<option value="{{ q }}"{{ q == 1 ? ' selected="selected"' }}>{{ q }}</option>{% endfor %}
                                                        </select>
                                                    </span>
                                                </h3>
                                                <div class="btn_product_detail">
                                                    <p class="detailBtn"><input type="submit" class="add-cart" value="カートに入れる"></p>
                                                    <p class="detailLikeBtn"><button type="button" id="favorite" class="addHeart"></button></p>
                                                </div>
                                            </div>
                                        </dd>
                                    </dl>
                                </div>
                                {% else %}
                                <div class="detailFind">
                                    <input type="button" class="ec-blockBtn--action" value="ただいま品切れ中です。" disabled="disabled">
                                </div>
                                {% endif %}
                                {{ form_widget(form.product_id) }}
                                {{ form_widget(form.ProductClass) }}
                                {{ form_widget(form._token) }}
                            </form>
                            <form id="form_favorite" action="{{ url('product_add_favorite', {id:Product.id}) }}" method="post"></form>
                            <div class="ec-modal">
                                                    <input type="checkbox" id="ec-modal-checkbox" class="checkbox">
                                                    <div class="ec-modal-overlay">
                                                        <label for="ec-modal-checkbox" class="ec-modal-overlay-close"></label>
                                                        <div class="ec-modal-wrap">
                                                            <label for="ec-modal-checkbox" class="ec-modal-close"><span class="ec-icon"><img src="/html/template/default/assets/icon/cross-dark.svg" alt=""></span></label>
                                                            <div id="ec-modal-header" class="text-center">カートに追加しました。</div>
                                                            <div class="ec-modal-box">
                                                                <div class="ec-role">
                                                                    <label for="ec-modal-checkbox" class="ec-inlineBtn--cancel">お買い物を続ける</label>
                                                                    <a href="/cart" class="ec-inlineBtn--action">カートへ進む</a>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                        </div>
                    </div>
                </div>
                <div class="detailAsus">
                    {{ Product.description_detail|raw }}
                </div>
                <div class="detailBor">
                                        <p>お買い上げ合計15,000円以上（矢各種、矢筒のいずれかを含む場合は55,000円以上）で送料無料</p>
                                        <ul>
                                            <li>[送料別途]と記載された商品は、お買い上げ金額にかかわらず別途送料が発生します。（送料無料の対象外となります。）</li>
                                            <li>15,000円以上（矢各種、矢筒を含む場合は55,000円以上）で送料無料適用はネット通販で一括ご注文の場合に限定させて頂きます。店頭販売・電話注文・分割注文等には適用されません。また、沖縄県及び一部地域は対象外となります。</li>
                                            <li>送料は商品の大きさと、お届けの地域により異なります。詳しくは<a href="#anchor03">[都道府県別配送料金一覧表]</a>をご覧ください。</li>
                                        </ul>
                                        <p class="col01">注意事項</p>
                                        <ul>
                                            <li>画像の特性上、掲載写真は実際の商品と若干異なります。</li>
                                            <li>通販価格(税込)は店頭価格と異なる場合があります。</li>
                                            <li>［受注生産］の商品は、各商品ページに納期を記載しておりますのでご確認ください。</li>
                                            <li>製造元出版元に在庫がない場合はキャンセルとなりますので、ご了承ください。</li>
                                            <li>商品代金の送金・振込手数料等はお客様ご負担となります。</li>
                                            <li>その他、詳細に関しましては<a href="/help/tradelaw" target="_black">[特定商取引の記載]</a>をご覧下さい。</li>
                                        </ul>
                                    </div>
            </div>
        </div>
    </div>
    <div class="guideArea anchorWrap">
    <span id="anchor03" class="anchor"></span>
    <h3 class="hdS NotoSerifJp">都道府県別配送料金</h3>
    <p class="guideNote taC">通信販売の配送料金一覧表</p>
    <ul class="list01">
        <li>・通信販売および工場直送時の都道府県別配送料金は以下の通りです。</li>
        <li>・商品カタログに表示されているサイズ(A～D)毎に送料が異なります。（「メール便対応」と記載のある商品は通常配送の場合送料Bに該当します。）</li>
        <li>・通常はヤマト運輸、一部大型商品は西濃運輸、佐川急便、福山通運のいずれかで発送します。</li>
        <li>・複数商品を同時にご注文頂くと、一番大きいサイズの料金が適用されます。</li>
        <li>・お買い上げ金額合計15,000円以上（矢各種、矢筒のいずれかを含む場合は55,000円以上）で送料無料（沖縄県除く）です。</li>
        <li>・[別途送料]の商品は、送料無料の対象外になります。<br><span class="redColor">ただし弓は、配送先が職場や学校など法人宛（沖縄県除く）の場合は送料無料となります。</span></li>
        <li>・メール便対象商品は配送方法で「メール便」が選択できます。メール便の送料は全国一律370円です。メール便はポスト投函となります。</li>
    </ul>
    <div class="tabScroll">
        <p class="tabNote sp">左右にスライドできます</p>
        <div class="scrollFix">
        <table class="table01">
            <thead>
                <tr>
                    <th style="width: 30%;">都道府県</th>
                    <th>Aサイズ</th>
                    <th>Bサイズ</th>
                    <th>Cサイズ</th>
                    <th>Dサイズ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th style="text-align: left;">北海道</th>
                    <td>10,600 円</td>
                    <td>1,760 円</td>
                    <td>2,350 円</td>
                    <td>1,100 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">青森・岩手・宮城・秋田・山形・福島</th>
                    <td>8,600 円</td>
                    <td>1,320 円</td>
                    <td>2,080 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">茨城・栃木・群馬・埼玉・千葉・東京・神奈川</th>
                    <td>6,900 円</td>
                    <td>1,210 円</td>
                    <td>1,980 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">新潟・富山・石川・福井・山梨・長野・岐阜・静岡・愛知</th>
                    <td>6,900 円</td>
                    <td>1,210 円</td>
                    <td>1,980 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">三重・滋賀・京都・大阪・兵庫・奈良・和歌山</th>
                    <td>7,300 円</td>
                    <td>1,320 円</td>
                    <td>2,080 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">鳥取・島根・岡山・広島・山口</th>
                    <td>8,100 円</td>
                    <td>1,540 円</td>
                    <td>2,200 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">徳島・香川・愛媛・高知</th>
                    <td>8,100 円</td>
                    <td>1,540 円</td>
                    <td>2,200 円</td>
                    <td>0 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">福岡・佐賀・長崎・熊本・大分・宮崎・鹿児島</th>
                    <td>9,200 円</td>
                    <td>1,760 円</td>
                    <td>2,350 円</td>
                    <td>1,100 円</td>
                </tr>
                <tr>
                    <th style="text-align: left;">沖縄県</th>
                    <td>13,700 円</td>
                    <td>2,500 円</td>
                    <td>4,680 円</td>
                    <td>4,400 円</td>
                </tr>
            </tbody>
        </table>
        </div>
    </div>
</div>
{% endblock %}
